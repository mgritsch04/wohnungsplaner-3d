{
  "name": "wohnungsplaner-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "node scripts/copy-draco.mjs && tsc -b && vite build --mode artifact && node scripts/escape-control-chars.mjs dist-artifact && node scripts/artifact-manifest.mjs",
    "build:pages": "node scripts/copy-draco.mjs && tsc -b && vite build --mode pages && node scripts/check-pages.mjs",
    "test:pages": "playwright test -c playwright.pages.config.ts",
    "test:artifact": "playwright test -c playwright.artifact.config.ts",
    "preview": "vite preview",
    "ikea-helper": "node scripts/ikea-helper.mjs",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/copy-draco.mjs",
    "prebuild": "node scripts/copy-draco.mjs",
    "pretest": "node scripts/copy-draco.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.0",
    "idb-keyval": "^6.3.0",
    "pdfjs-dist": "^6.4.299",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
